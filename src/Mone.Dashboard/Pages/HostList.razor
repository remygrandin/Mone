@page "/hosts"
@using Mone.Dashboard.Helpers
@using Mone.Dashboard.Models
@using Mone.Dashboard.Services
@using Mone.Dashboard.Shared
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Hosts - Mone</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Hosts</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddHostDialog">Add Host</MudButton>
</div>

<StateView Loading="_loading" Error="@_error" IsEmpty="@(_hosts.Count == 0)"
           EmptyText="No hosts yet. Add your first host to start monitoring."
           EmptyIcon="@Icons.Material.Filled.Dns"
           EmptyActionText="Add Host"
           EmptyActionIcon="@Icons.Material.Filled.Add"
           OnEmptyAction="OpenAddHostDialog">
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Filter by Tags</MudText>
        <MudChipSet T="Guid" SelectionMode="SelectionMode.MultiSelection" SelectedValuesChanged="OnTagSelectionChanged">
            @foreach (var tag in _tags)
            {
                <MudChip T="Guid" Value="tag.Id" Variant="Variant.Outlined" Color="Color.Primary">
                    @tag.Name (@tag.HostCount)
                </MudChip>
            }
        </MudChipSet>
    </MudPaper>

    <MudDataGrid Items="_hosts" Hover="true" Dense="true" RowClick="OnRowClick" T="HostViewModel" Class="cursor-pointer">
        <Columns>
            <PropertyColumn Property="x => x.Host.Name" Title="Name" />
            <PropertyColumn Property="x => x.Host.Address" Title="Address" />
            <TemplateColumn Title="Enabled">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item.Host.Enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                             Color="@(context.Item.Host.Enabled ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <StatusIndicator Status="@context.Item.Status" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tags">
                <CellTemplate>
                    @foreach (var tag in context.Item.Host.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@tag.Name</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</StateView>

@code {
    private bool _loading = true;
    private string? _error;
    private List<HostViewModel> _hosts = [];
    private TagResponse[] _tags = [];
    private Guid[] _selectedTagIds = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
        _tags = await Api.GetTagsAsync();
        var hosts = await Api.GetHostsAsync(_selectedTagIds.Length > 0 ? _selectedTagIds : null);

        var tasks = hosts.Select(async host =>
        {
            var status = MonitoringStatus.Unknown;
            try
            {
                var latestStatuses = await Api.GetLatestStatusAsync(host.Id);
                if (latestStatuses.Length > 0)
                    status = latestStatuses.Max(s => s.CurrentStatus);
            }
            catch
            {
                // Per-host status is best-effort: degrade to Unknown so one host's
                // status fetch failing never blocks rendering the rest of the list.
            }
            return new HostViewModel(host, status);
        });

        _hosts = (await Task.WhenAll(tasks)).ToList();
        }
        catch (ApiException ax)
        {
            _error = ax.Message;
        }
        catch (Exception)
        {
            _error = "Unable to load hosts. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTagSelectionChanged(IReadOnlyCollection<Guid> selectedValues)
    {
        _selectedTagIds = selectedValues.ToArray();
        await LoadDataAsync();
    }

    private void OnRowClick(DataGridRowClickEventArgs<HostViewModel> args)
    {
        Nav.NavigateTo($"/hosts/{args.Item.Host.Id}");
    }

    private async Task OpenAddHostDialog()
    {
        var parameters = new DialogParameters<HostDialog>
        {
            { x => x.Model, new HostDialog.FormModel() },
            { x => x.IsEdit, false }
        };

        var dialog = await DialogService.ShowAsync<HostDialog>("Add Host", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: HostDialog.FormModel model })
        {
            try
            {
                await Api.CreateHostAsync(new CreateHostRequest(model.Name, model.Address, model.Enabled, model.TagIds));
                Snackbar.Add("Host created.", Severity.Success);
                await LoadDataAsync();
            }
            catch (ApiException ax)
            {
                Snackbar.Add(ax.Message, Severity.Error);
            }
        }
    }

    private sealed record HostViewModel(HostResponse Host, MonitoringStatus Status);
}
