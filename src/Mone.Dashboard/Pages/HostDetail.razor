    private void ToggleMetadata(ProbeResultResponse result)
    {
        if (!_expandedResults.Remove(result))
            _expandedResults.Add(result);
    }

    private static Dictionary<string, string> ParseMetadata(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new();

        try
        {
            var dict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);
            if (dict is null) return new();
            return dict.ToDictionary(kv => kv.Key, kv => kv.Value.ToString());
        }
        catch
        {
            return new() { ["raw"] = json };
        }
    }

