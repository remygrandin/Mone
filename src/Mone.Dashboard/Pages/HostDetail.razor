@page "/hosts/{Id:guid}"
@using Mone.Dashboard.Models
@using Mone.Dashboard.Shared
@using System.Text.Json
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Host Detail - Mone</PageTitle>

@if (_loading)
{
    <LoadingIndicator />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <ErrorAlert Message="@_error" />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/hosts"))" Class="mt-4">
        Back to Hosts
    </MudButton>
}
else if (_host is null)
{
    <MudAlert Severity="Severity.Error">Host not found.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/hosts"))" Class="mt-4">
        Back to Hosts
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/hosts"))" Class="mb-2">
        Back to Hosts
    </MudButton>

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">@_host.Name</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudChip T="string" Color="@(_host.Enabled ? Color.Success : Color.Error)" Size="Size.Small">
                    @(_host.Enabled ? "Enabled" : "Disabled")
                </MudChip>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Address</MudText>
                    <MudText Typo="Typo.body1">@_host.Address</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Created</MudText>
                    <MudText Typo="Typo.body1">@_host.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudItem>
            </MudGrid>
            @if (_host.Tags.Length > 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Tags</MudText>
                <div class="mt-1">
                    @foreach (var tag in _host.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mr-1">@tag.Name</MudChip>
                    }
                </div>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History"
                       OnClick="@(() => Nav.NavigateTo($"/hosts/{Id}/status"))">
                View Status History
            </MudButton>
        </MudCardActions>
    </MudCard>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="ActiveTab">

        @* ───────────────────────── Dashboard ───────────────────────── *@
        <MudTabPanel Text="Dashboard" Icon="@Icons.Material.Filled.Dashboard">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-2">Metrics</MudText>
                    @if (_metricKeys.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info">No numeric metrics recorded for this host yet.</MudAlert>
                    }
                    else
                    {
                        @foreach (var key in _metricKeys)
                        {
                            var decl = ResolveDeclaration(key);
                            var displayName = decl?.DisplayName ?? key;
                            var unit = decl?.Unit;
                            var mapping = _metricValueMaps.TryGetValue(key, out var mv) ? mv : null;
                            <div @key="@key" style="position:relative;overflow:hidden;min-height:56px;padding:8px 12px;margin-bottom:6px;border:1px solid var(--mud-palette-lines-default);border-radius:4px;">
                                @if (_metricSeries.TryGetValue(key, out var s) && s is not null && s.Points.Length > 0)
                                {
                                    <div style="position:absolute;inset:0;opacity:0.5;pointer-events:none;z-index:0;">
                                        <Sparkline Points="@s.Points" FullWidth="true" Height="56" Background="true"
                                                   Unit="@unit" DisplayName="@displayName" ValueMapping="@mapping" />
                                    </div>
                                }
                                <div style="position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;">
                                    <div style="min-width:0;">
                                        <MudText Typo="Typo.body1" Style="font-weight:500;">@displayName@(unit is null ? "" : $" ({unit})")</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@key</MudText>
                                    </div>
                                    <div style="text-align:right;font-variant-numeric:tabular-nums;flex-shrink:0;">
                                        @if (_metricSeries.TryGetValue(key, out var s2) && s2?.Latest is { } latest)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Primary">@FormatLatest(latest, unit, mapping)</MudText>
                                        }
                                        else if (_metricSeriesLoading.Contains(key))
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <span class="mud-text-secondary">—</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-2">Checker Results</MudText>
                    @if (_effectiveCheckers.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info">No checkers assigned to this host.</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th>Checker</th>
                                    <th>Latest Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var checker in _effectiveCheckers)
                                {
                                    <tr>
                                        <td>@CheckerDisplayName(checker.CheckerPluginId)</td>
                                        <td>
                                            <StatusIndicator Status="@GetCheckerStatus(checker.CheckerPluginId)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.h6" Class="mb-2 mt-4">Probes</MudText>
            @if (_effectiveProbes.Length == 0)
            {
                <MudAlert Severity="Severity.Info">No probes assigned to this host.</MudAlert>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Last Run</th>
                            <th>Trigger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var probe in _effectiveProbes)
                        {
                            <tr>
                                <td>@ProbeRowHelper.ResolveDisplayName(ResolveProbeAssignmentName(probe.AssignmentId), probe.ProbePluginId)</td>
                                <td>@ProbeRowHelper.FormatLastRun(GetLastRun(probe.ProbePluginId), DateTimeOffset.UtcNow)</td>
                                <td>
                                    @{
                                        var dashIsPassive = IsPassiveProbe(probe.ProbePluginId);
                                    }
                                    <MudTooltip Text="@(dashIsPassive ? "Passive probes cannot be triggered manually" : "Trigger probe now")">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small"
                                                       Disabled="@dashIsPassive"
                                                       OnClick="@(() => TriggerProbeFromDashboardAsync(probe))" />
                                    </MudTooltip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>

        @* ───────────────────────── Analysis ───────────────────────── *@
        <MudTabPanel Text="Analysis" Icon="@Icons.Material.Filled.QueryStats">
            <MudPaper Class="pa-4 mb-4" Elevation="0">
                <div class="d-flex flex-wrap align-center gap-2 mb-1">
                    <MudTextField T="DateTime?" Label="From" @bind-Value="_analysisStart"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px;" />
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mx-1" />
                    <MudTextField T="DateTime?" Label="To" @bind-Value="_analysisEnd"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                               OnClick="LoadAnalysisAsync" Disabled="_analysisLoading">Apply</MudButton>
                    @if (_analysisLoading)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="ml-1">Loading…</MudText>
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" Style="vertical-align:text-bottom;" />
                    Times are entered and shown in your local timezone (@LocalTzOffset()).
                </MudText>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromMinutes(30)))">Last 30 min</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromHours(1)))">Last hour</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromHours(6)))">Last 6h</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromHours(24)))">Last 24h</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromDays(7)))">Last week</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => ApplyQuickRange(TimeSpan.FromDays(30)))">Last month</MudButton>
                </div>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Metrics (click to plot)</MudText>
                    @if (_metricKeys.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info">No metrics to plot.</MudAlert>
                    }
                    else
                    {
                        <MudTextField T="string" @bind-Value="_metricSearch" Immediate="true"
                                      Placeholder="Search name, unit, plugin..." Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                                      Margin="Margin.Dense" Class="mb-2" />
                        @if (FilterMetricKeys().Length == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">No metrics match the search.</MudText>
                        }
                        else
                        {
                            <div style="max-height:560px;overflow-y:auto;padding-right:4px;">
                                @foreach (var key in FilterMetricKeys())
                                {
                                    var decl = ResolveDeclaration(key);
                                    var displayName = decl?.DisplayName ?? key;
                                    var unit = decl?.Unit;
                                    var probeName = decl?.ProbeAssignmentName;
                                    var mapping = _metricValueMaps.TryGetValue(key, out var mv) ? mv : null;
                                    var selected = _selectedMetricKeys.Contains(key);
                                    <MudPaper @key="@key" Outlined="true" Class="pa-2 mb-2"
                                              Style="@($"cursor:pointer;{(selected ? "outline:2px solid var(--mud-palette-primary);outline-offset:-1px;" : "")}")"
                                              @onclick="@(() => ToggleMetricSelection(key))">
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <MudIcon Icon="@(selected ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                                     Size="Size.Small" Color="@(selected ? Color.Primary : Color.Default)" />
                                            <div style="flex:1;min-width:0;">
                                                <div style="display:flex;align-items:center;gap:8px;">
                                                    <MudText Typo="Typo.body2" Style="flex:1;min-width:0;font-weight:500;">@displayName@(unit is null ? "" : $" ({unit})")</MudText>
                                                    @if (!string.IsNullOrEmpty(probeName))
                                                    {
                                                        <MudTooltip Text="@($"Probe: {probeName}")">
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="ma-0">@probeName</MudChip>
                                                        </MudTooltip>
                                                    }
                                                </div>
                                                @if (_analysisSeries.TryGetValue(key, out var s) && s is not null && s.Points.Length > 0)
                                                {
                                                    <Sparkline Points="@s.Points" FullWidth="true" Height="28"
                                                               Unit="@unit" DisplayName="@displayName" ValueMapping="@mapping" />
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">no data in range</MudText>
                                                }
                                            </div>
                                        </div>
                                    </MudPaper>
                                }
                            </div>
                        }
                    }
                </MudItem>

                <MudItem xs="12" md="8">
                    <div id="@_analysisFigureId" style="position:relative;width:100%;">
                        <AnalysisChart CanvasId="@_analysisChartCanvasId" Series="@BuildAnalysisSeries()" Width="760" Height="380" />
                        @{
                            var (stripStart, stripEnd) = StripDomain();
                        }
                        <AnalysisStatusStrips FigureId="@_analysisFigureId" ChartCanvasId="@_analysisChartCanvasId"
                                              Start="@stripStart" End="@stripEnd"
                                              Host="@BuildHostTrack(stripStart, stripEnd)"
                                              Checkers="@BuildCheckerTracks(stripStart, stripEnd)" />
                    </div>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.h6" Class="mt-6 mb-2">Checker State Changes</MudText>
            @{
                var stateChanges = _statusHistory
                    .Where(s => s.PreviousStatus != s.CurrentStatus)
                    .OrderByDescending(s => s.Timestamp)
                    .ToArray();
            }
            @if (stateChanges.Length == 0)
            {
                <MudAlert Severity="Severity.Info">No checker state changes in the selected range.</MudAlert>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Checker</th>
                            <th>State Change</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in stateChanges)
                        {
                            <tr>
                                <td>@CheckerDisplayName(change.CheckerId)</td>
                                <td>
                                    <div class="d-flex align-center gap-1">
                                        <StatusIndicator Status="@change.PreviousStatus" />
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                        <StatusIndicator Status="@change.CurrentStatus" />
                                    </div>
                                </td>
                                <td>
                                    <MudTooltip Text="@change.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")">
                                        @change.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </MudTooltip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <MudText Typo="Typo.h6" Class="mt-6 mb-2">Probe Results</MudText>
            <MudPaper Class="pa-4 mb-4" Elevation="0">
                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="Refresh now">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary"
                                       OnClick="LoadProbeResultsAsync" Disabled="_probeResultsLoading" />
                    </MudTooltip>
                    <MudTooltip Text="@(AutoRefreshEnabled ? "Disable auto-refresh" : "Enable auto-refresh (10s)")">
                        <MudToggleIconButton @bind-Toggled="AutoRefreshEnabled"
                                             Icon="@Icons.Material.Outlined.Timer" ToggledIcon="@Icons.Material.Filled.Timer"
                                             Color="Color.Default" ToggledColor="Color.Primary"
                                             Size="Size.Medium" />
                    </MudTooltip>
                    @if (AutoRefreshEnabled)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary">Auto-refresh on</MudText>
                    }
                </div>
            </MudPaper>

            @if (_probeResultsLoading)
            {
                <MudProgressCircular Indeterminate="true" Class="d-flex mx-auto my-4" />
            }
            else if (_probeResults.Length == 0)
            {
                <MudAlert Severity="Severity.Info">No probe results found for the selected date range.</MudAlert>
            }
            else
            {
                <MudTable Items="@_probeResults" Dense="true" Hover="true" Striped="true"
                          RowsPerPage="@_pageSize" T="ProbeResultResponse">
                    <HeaderContent>
                        <MudTh Style="width:50px;"></MudTh>
                        <MudTh>Probe</MudTh>
                        <MudTh>Plugin ID</MudTh>
                        <MudTh>Timestamp</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Summary</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(context.MetadataJson))
                            {
                                <MudIconButton Icon="@(_expandedResults.Contains(context) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               Size="Size.Small" OnClick="@(() => ToggleMetadata(context))" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Probe">@ResolveInstanceName(context)</MudTd>
                        <MudTd DataLabel="Plugin ID">
                            <MudTooltip Text="@FullPluginLabel(context.ProbeId)">
                                @ProbeNameFromPluginId(context.ProbeId)
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Timestamp">
                            <MudTooltip Text="@context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")">
                                @context.Timestamp.ToLocalTime().ToString("MM-dd HH:mm:ss")
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <StatusIndicator Status="@context.Status" />
                        </MudTd>
                        <MudTd DataLabel="Summary">@context.Summary</MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (_expandedResults.Contains(context))
                        {
                            <MudTr>
                                <td colspan="6" class="pa-4" style="background-color: var(--mud-palette-background-gray);">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Metadata</MudText>
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background: transparent;table-layout:fixed;width:100%;">
                                        <thead>
                                            <tr><th style="width:280px;">Key</th><th>Value</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var kv in ParseMetadata(context.MetadataJson))
                                            {
                                                <tr><td style="width:280px;word-break:break-word;"><strong>@kv.Key</strong></td><td style="word-break:break-word;">@kv.Value</td></tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>

        @* ───────────────────────── Settings ───────────────────────── *@
        <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
            <MudText Typo="Typo.h6" Class="mb-2">Host Settings</MudText>
            <MudPaper Class="pa-4 mb-6" Elevation="0">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="OpenEditDialog">
                        Edit
                    </MudButton>
                    <MudButton Variant="@(_host.Enabled ? Variant.Outlined : Variant.Filled)"
                               Color="@(_host.Enabled ? Color.Warning : Color.Success)"
                               StartIcon="@(_host.Enabled ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)"
                               OnClick="ToggleHostEnabledAsync">
                        @(_host.Enabled ? "Disable" : "Enable")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="OpenDeleteDialog">
                        Delete
                    </MudButton>
                </div>
            </MudPaper>

            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.h6">Probe Assignments (@_effectiveProbes.Length)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddProbeDialog" Size="Size.Small">
                    Add Probe
                </MudButton>
            </div>
            @if (_effectiveProbes.Length == 0)
            {
                <MudAlert Severity="Severity.Info">No probes assigned to this host.</MudAlert>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true">
                    <thead>
                        <tr>
                            <th>Probe</th>
                            <th>Plugin ID</th>
                            <th>Schedule</th>
                            <th>Enabled</th>
                            <th>Source</th>
                            <th>Override</th>
                            <th>Last Run</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var probe in AssignmentOrdering.ByNameEnabledFirst(_effectiveProbes, p => ProbeRowHelper.ResolveDisplayName(ResolveProbeAssignmentName(p.AssignmentId), p.ProbePluginId), p => p.Enabled))
                        {
                            <tr class="@(probe.Enabled ? null : "assignment-row--disabled")">
                                <td>
                                    @(AssignmentOrdering.WithDisabledSuffix(ResolveProbeAssignmentName(probe.AssignmentId) ?? ProbeNameFromPluginId(probe.ProbePluginId), probe.Enabled))
                                    @if (!string.IsNullOrWhiteSpace(probe.TargetAddressOverride))
                                    {
                                        <MudTooltip Text="@($"Target address override: {probe.TargetAddressOverride}")">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">
                                                <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" Style="vertical-align:text-bottom;" />
                                                @probe.TargetAddressOverride
                                            </MudText>
                                        </MudTooltip>
                                    }
                                </td>
                                <td><code>@FullPluginLabel(probe.ProbePluginId)</code></td>
                                <td><code>@probe.ScheduleCron</code></td>
                                <td>
                                    <MudIcon Icon="@(probe.Enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                             Color="@(probe.Enabled ? Color.Success : Color.Error)" Size="Size.Small" />
                                </td>
                                <td>
                                    @if (probe.SourceType == "Direct")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Direct</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.AccountTree">
                                            @ResolveGroupName(probe.SourceGroupId)
                                        </MudChip>
                                    }
                                </td>
                                <td>
                                    @if (probe.IsOverridden)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Edit">Overridden</MudChip>
                                    }
                                </td>
                                <td>
                                    @if (GetLastRun(probe.ProbePluginId) is { } lastRun)
                                    {
                                        <MudTooltip Text="@lastRun.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
                                            <MudText Typo="Typo.body2">@FormatRelativeTime(lastRun)</MudText>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Never</MudText>
                                    }
                                </td>
                                <td Style="white-space:nowrap;">
                                    @if (probe.SourceType == "Direct")
                                    {
                                        <MudTooltip Text="Edit assignment">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => OpenEditProbeDialog(probe))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Delete assignment">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           OnClick="@(() => DeleteProbeAsync(probe.AssignmentId))" />
