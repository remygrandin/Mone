    private async Task ForceStatusAsync(string checkerPluginId, MonitoringStatus status)
    {
        try
        {
            await Api.ForceStatusAsync(Id, checkerPluginId, status);
            Snackbar.Add($"Forced '{checkerPluginId}' to {status}.", Severity.Success);

            // Reload status history and update only the affected checker's status indicator.
            var statusHistory = await Api.GetStatusHistoryAsync(Id);
            var latestForChecker = statusHistory
                .Where(s => s.CheckerId == checkerPluginId)
                .OrderByDescending(s => s.Timestamp)
                .FirstOrDefault();
            if (latestForChecker is not null)
                _checkerStatusLookup[checkerPluginId] = latestForChecker.CurrentStatus;
            StateHasChanged();
        }
        catch (ApiException ax)
        {
            Snackbar.Add(ax.Message, Severity.Error);
        }
    }

