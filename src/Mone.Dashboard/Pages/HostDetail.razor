    private DateTimeOffset? GetLastRun(string probePluginId) =>
        _lastProbeRun.GetValueOrDefault(probePluginId);

    private bool IsPassiveProbe(string probePluginId)
    {
        var plugin = _loadedPlugins.FirstOrDefault(p => p.PluginId == probePluginId);
        return string.Equals(plugin?.ProbeMode, "Passive", StringComparison.OrdinalIgnoreCase);
    }

    // The plugin id keys on the declared semver (e.g. PingProbe@1.0.0), which does not move
    // with CI prerelease bumps. Surface the assembly's informational version when we have it.
    private string FullPluginLabel(string probePluginId)
    {
        var plugin = _loadedPlugins.FirstOrDefault(p => p.PluginId == probePluginId);
        if (plugin is null || string.IsNullOrWhiteSpace(plugin.InformationalVersion))
            return probePluginId;
        return $"{plugin.Name}@{plugin.InformationalVersion}";
    }

    private static string ProbeNameFromPluginId(string probePluginId)
    {
        var at = probePluginId.IndexOf('@');
        return at > 0 ? probePluginId[..at] : probePluginId;
    }

    // Probe-result metadata keys are prefixed with the assignment's snake_case name
    // (ProbeExecutionJob.PrefixMetadataKeys), so the prefix before the first '.' identifies
    // the instance. Fall back to the plugin name when a result carries no usable metadata.
    private string ResolveInstanceName(ProbeResultResponse result)
    {
        if (!string.IsNullOrEmpty(result.MetadataJson) && _probeAssignmentSnakeNames.Count > 0)
        {
            foreach (var key in ParseMetadata(result.MetadataJson).Keys)
            {
                var dot = key.IndexOf('.');
                if (dot <= 0) continue;
                if (_probeAssignmentSnakeNames.TryGetValue(key[..dot], out var name))
                    return name;
            }
        }
        return ProbeNameFromPluginId(result.ProbeId);
    }

    private static string FormatRelativeTime(DateTimeOffset timestamp)
    {
        var elapsed = DateTimeOffset.UtcNow - timestamp;
        if (elapsed.TotalSeconds < 60) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

