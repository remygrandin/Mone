    private async Task LoadAllMetricSeriesAsync()
    {
        if (_metricKeys.Length == 0) return;

        foreach (var k in _metricKeys)
            _metricSeriesLoading.Add(k);
        await InvokeAsync(StateHasChanged);

        var tasks = _metricKeys.Select(async key =>
        {
            try
            {
                var series = await Api.GetMetricSeriesAsync(Id, key, 60);
                _metricSeries[key] = series;
            }
            catch
            {
                _metricSeries[key] = null;
            }
            finally
            {
                _metricSeriesLoading.Remove(key);
                await InvokeAsync(StateHasChanged);
            }
        });
        await Task.WhenAll(tasks);
    }

    private async Task LoadProbeResultsAsync()
    {
        _probeResultsLoading = true;
        StateHasChanged();

        try
        {
            var (from, to) = AnalysisRange();
            _probeResults = await Api.GetProbeResultsAsync(Id, from, to);
        }
        catch (Exception)
        {
            _probeResults = [];
        }
        finally
        {
            _probeResultsLoading = false;
        }
    }

    private (DateTimeOffset? From, DateTimeOffset? To) AnalysisRange()
    {
        // Pickers show local time; resolve to the UTC instant before sending, since
        // the server queries `timestamp with time zone` columns (Npgsql requires offset 0).
        DateTimeOffset? from = _analysisStart.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_analysisStart.Value, DateTimeKind.Local)).ToUniversalTime()
            : null;
        DateTimeOffset? to = _analysisEnd.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_analysisEnd.Value, DateTimeKind.Local)).ToUniversalTime()
            : null;
        return (from, to);
    }

    private async Task ApplyQuickRange(TimeSpan span)
    {
        var now = DateTime.Now;
        _analysisStart = now - span;
        _analysisEnd = now;
        await LoadAnalysisAsync();
    }

    private async Task LoadAnalysisAsync()
    {
        _analysisLoading = true;
        StateHasChanged();
        try
        {
            var (from, to) = AnalysisRange();

            var historyTask = Api.GetStatusHistoryAsync(Id, from, to);
            var seriesTasks = _metricKeys.ToDictionary(k => k, k => Api.GetMetricSeriesAsync(Id, k, 60, from, to));

            try { await Task.WhenAll(seriesTasks.Values.Concat(new Task[] { historyTask })); }
            catch { /* surface per-task results below */ }

            foreach (var (k, t) in seriesTasks)
                _analysisSeries[k] = t.IsCompletedSuccessfully ? t.Result : null;

            _statusHistory = historyTask.IsCompletedSuccessfully ? historyTask.Result : [];

            await LoadProbeResultsAsync();
        }
        catch { /* leave existing data in place */ }
        finally
        {
            _analysisLoading = false;
            _analysisLoaded = true;
            StateHasChanged();
        }
    }

    private void ToggleMetricSelection(string key)
    {
        if (!_selectedMetricKeys.Remove(key))
            _selectedMetricKeys.Add(key);
    }

    private IReadOnlyList<AnalysisChart.AnalysisSeries> BuildAnalysisSeries()
    {
        var list = new List<AnalysisChart.AnalysisSeries>();
        foreach (var key in _selectedMetricKeys)
        {
            if (_analysisSeries.TryGetValue(key, out var s) && s is not null && s.Points.Length > 0)
            {
                var decl = ResolveDeclaration(key);
                var label = decl is null
                    ? key
                    : string.IsNullOrWhiteSpace(decl.ProbeAssignmentName)
                        ? decl.DisplayName
                        : $"{decl.ProbeAssignmentName}: {decl.DisplayName}";
                list.Add(new AnalysisChart.AnalysisSeries(
                    key, label, decl?.Unit, null, s.Points));
            }
        }
        return list;
    }

    // ── Status strips ────────────────────────────────────────────────────────
    // The strips share the chart's selected window. AnalysisRange() returns the
    // UTC instants the API was queried with; fall back to the data extent when a
    // picker is empty so the strips still span something sensible.
    private (DateTimeOffset Start, DateTimeOffset End) StripDomain()
    {
        var (from, to) = AnalysisRange();
        var start = from ?? EarliestKnown();
        var end = to ?? DateTimeOffset.UtcNow;
        if (end <= start) end = start.AddMinutes(1);
        return (start, end);
    }

    private DateTimeOffset EarliestKnown()
    {
        DateTimeOffset? earliest = _statusHistory.Length > 0 ? _statusHistory.Min(s => s.Timestamp) : null;
        return earliest ?? DateTimeOffset.UtcNow.AddHours(-24);
    }

    private static string StatusCss(MonitoringStatus status) => status switch
    {
        MonitoringStatus.Healthy => "var(--mud-palette-success)",
        MonitoringStatus.Degraded => "var(--mud-palette-warning)",
        MonitoringStatus.Unhealthy => "var(--mud-palette-error)",
        MonitoringStatus.Unreachable => "var(--mud-palette-dark)",
        _ => "var(--mud-palette-lines-default)",
    };

    // Higher == worse. Unknown sits below Healthy so it never masks real data when
    // computing the host envelope, yet wins when nothing else is known.
    private static int StatusSeverity(MonitoringStatus s) => s switch
    {
        MonitoringStatus.Unreachable => 4,
        MonitoringStatus.Unhealthy => 3,
        MonitoringStatus.Degraded => 2,
        MonitoringStatus.Healthy => 1,
        _ => 0,
    };

    private readonly record struct StatusSpan(DateTimeOffset Start, DateTimeOffset End, MonitoringStatus Status);

    // Build a continuous timeline for one checker from its transition rows. Each row
    // says "PreviousStatus held until Timestamp, then CurrentStatus took over".
    private List<StatusSpan> BuildSpans(IReadOnlyList<StatusResponse> transitions, DateTimeOffset start, DateTimeOffset end, MonitoringStatus fallback)
    {
        var spans = new List<StatusSpan>();
        var ordered = transitions.OrderBy(t => t.Timestamp).ToList();
        if (ordered.Count == 0)
        {
            spans.Add(new StatusSpan(start, end, fallback));
            return spans;
        }

        var cursor = start;
        var current = ordered[0].PreviousStatus;
        foreach (var tr in ordered)
        {
            var at = tr.Timestamp < start ? start : tr.Timestamp > end ? end : tr.Timestamp;
            if (at > cursor)
            {
                spans.Add(new StatusSpan(cursor, at, current));
                cursor = at;
            }
            current = tr.CurrentStatus;
        }
        if (cursor < end)
            spans.Add(new StatusSpan(cursor, end, current));
        return spans;
    }

    private MonitoringStatus StatusAt(List<StatusSpan> spans, DateTimeOffset at)
    {
        foreach (var s in spans)
            if (at >= s.Start && at < s.End) return s.Status;
        return spans.Count > 0 ? spans[^1].Status : MonitoringStatus.Unknown;
    }

    private static AnalysisStatusStrips.Segment ToSegment(StatusSpan s) =>
        new(s.Start, s.End, StatusCss(s.Status), StatusColorHelper.ToLabel(s.Status));

    private string CheckerDisplayName(string checkerPluginId)
    {
        var match = _effectiveCheckers.FirstOrDefault(c => c.CheckerPluginId == checkerPluginId);
        var name = match is null ? null : ResolveCheckerAssignmentName(match.AssignmentId);
        return string.IsNullOrWhiteSpace(name) ? checkerPluginId : name;
    }

    // One strip per checker that has a current status or history in range, plus any
    // assigned checker even if it never reported (shown flat at its known status).
    private List<(string Id, List<StatusSpan> Spans)> BuildCheckerSpans(DateTimeOffset start, DateTimeOffset end)
    {
        var ids = _effectiveCheckers.Select(c => c.CheckerPluginId)
            .Concat(_statusHistory.Select(s => s.CheckerId))
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(id => CheckerDisplayName(id), StringComparer.OrdinalIgnoreCase)
            .ToList();

        var result = new List<(string, List<StatusSpan>)>();
        foreach (var id in ids)
        {
            var transitions = _statusHistory.Where(s => s.CheckerId == id).ToList();
            var fallback = GetCheckerStatus(id);
            result.Add((id, BuildSpans(transitions, start, end, fallback)));
        }
        return result;
    }

    private IReadOnlyList<AnalysisStatusStrips.Track> BuildCheckerTracks(DateTimeOffset start, DateTimeOffset end) =>
        BuildCheckerSpans(start, end)
            .Select(c =>
            {
                var current = StatusAt(c.Spans, end);
                return new AnalysisStatusStrips.Track(
                    CheckerDisplayName(c.Id),
                    c.Spans.Select(ToSegment).ToList(),
                    StatusCss(current),
                    StatusColorHelper.ToLabel(current));
            })
            .ToList();

    // Host timeline = worst checker status in each interval (the envelope), so the
    // top strip reflects overall host health over the window.
    private AnalysisStatusStrips.Track? BuildHostTrack(DateTimeOffset start, DateTimeOffset end)
    {
        var checkers = BuildCheckerSpans(start, end);
        if (checkers.Count == 0) return null;

        var breakpoints = new SortedSet<DateTimeOffset> { start, end };
        foreach (var (_, spans) in checkers)
            foreach (var s in spans)
            {
                if (s.Start > start && s.Start < end) breakpoints.Add(s.Start);
                if (s.End > start && s.End < end) breakpoints.Add(s.End);
            }

        var bps = breakpoints.ToList();
        var hostSpans = new List<StatusSpan>();
        for (var i = 0; i + 1 < bps.Count; i++)
        {
            var a = bps[i];
            var b = bps[i + 1];
            var mid = a + TimeSpan.FromTicks((b - a).Ticks / 2);
            var worst = MonitoringStatus.Unknown;
            foreach (var (_, spans) in checkers)
            {
                var st = StatusAt(spans, mid);
                if (StatusSeverity(st) > StatusSeverity(worst)) worst = st;
            }
            // Coalesce adjacent equal-status intervals into one segment.
            if (hostSpans.Count > 0 && hostSpans[^1].Status == worst)
                hostSpans[^1] = hostSpans[^1] with { End = b };
            else
                hostSpans.Add(new StatusSpan(a, b, worst));
        }

        var currentHost = hostSpans.Count > 0 ? hostSpans[^1].Status : MonitoringStatus.Unknown;
        return new AnalysisStatusStrips.Track(
            "Host status",
            hostSpans.Select(ToSegment).ToList(),
            StatusCss(currentHost),
            StatusColorHelper.ToLabel(currentHost));
    }

