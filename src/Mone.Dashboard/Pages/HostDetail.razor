                                    }
                                    @{
                                        var isPassive = IsPassiveProbe(probe.ProbePluginId);
                                    }
                                    <MudTooltip Text="@(isPassive ? "Passive probes cannot be triggered manually" : "Trigger probe now")">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small"
                                                       Disabled="@isPassive"
                                                       OnClick="@(() => TriggerProbeAsync(probe))" />
                                    </MudTooltip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <div class="d-flex align-center justify-space-between mb-2 mt-6">
                <MudText Typo="Typo.h6">Checker Assignments (@_effectiveCheckers.Length)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddCheckerDialog" Size="Size.Small">
                    Add Checker
                </MudButton>
            </div>
            @if (_effectiveCheckers.Length == 0)
            {
                <MudAlert Severity="Severity.Info">No checkers assigned to this host.</MudAlert>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true">
                    <thead>
                        <tr>
                            <th>Checker</th>
                            <th>Plugin ID</th>
                            <th>Enabled</th>
                            <th>Source</th>
                            <th>Override</th>
                            <th>Latest Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checker in AssignmentOrdering.ByNameEnabledFirst(_effectiveCheckers, c => ResolveCheckerAssignmentName(c.AssignmentId) ?? c.CheckerPluginId, c => c.Enabled))
                        {
                            <tr class="@(checker.Enabled ? null : "assignment-row--disabled")">
                                <td>@(AssignmentOrdering.WithDisabledSuffix(ResolveCheckerAssignmentName(checker.AssignmentId) ?? checker.CheckerPluginId, checker.Enabled))</td>
                                <td><code>@checker.CheckerPluginId</code></td>
                                <td>
                                    <MudIcon Icon="@(checker.Enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                             Color="@(checker.Enabled ? Color.Success : Color.Error)" Size="Size.Small" />
                                </td>
                                <td>
                                    @if (checker.SourceType == "Direct")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Direct</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.AccountTree">
                                            @ResolveGroupName(checker.SourceGroupId)
                                        </MudChip>
                                    }
                                </td>
                                <td>
                                    @if (checker.IsOverridden)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Edit">Overridden</MudChip>
                                    }
                                </td>
                                <td style="white-space:nowrap;">
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <StatusIndicator Status="@GetCheckerStatus(checker.CheckerPluginId)" />
                                        <MudTooltip Text="Force status">
                                            <MudMenu Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Small" Dense="true" AriaLabel="Force status">
                                                <MudMenuItem OnClick="@(() => ForceStatusAsync(checker.CheckerPluginId, MonitoringStatus.Healthy))">Healthy</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ForceStatusAsync(checker.CheckerPluginId, MonitoringStatus.Degraded))">Degraded</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ForceStatusAsync(checker.CheckerPluginId, MonitoringStatus.Unhealthy))">Unhealthy</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => ForceStatusAsync(checker.CheckerPluginId, MonitoringStatus.Unreachable))">Unreachable</MudMenuItem>
                                            </MudMenu>
                                        </MudTooltip>
                                        @if (checker.SourceType == "Direct")
                                        {
                                            <MudTooltip Text="Edit assignment">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                               OnClick="@(() => OpenEditCheckerDialog(checker))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Delete assignment">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => DeleteCheckerAsync(checker.AssignmentId))" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="Edit override">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                               OnClick="@(() => OpenCheckerOverrideDialog(checker))" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@implements IDisposable

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private HostResponse? _host;
    private EffectiveProbeAssignment[] _effectiveProbes = [];
    private EffectiveCheckerAssignment[] _effectiveCheckers = [];
    private OverrideResponse[] _probeOverrides = [];
    private OverrideResponse[] _checkerOverrides = [];
    private LoadedPluginModel[] _loadedPlugins = [];
    private ExecutorNodeResponse[] _executorNodes = [];
    private Dictionary<Guid, string> _groupNames = new();
    private Dictionary<string, MonitoringStatus> _checkerStatusLookup = new();
    private Dictionary<string, DateTimeOffset> _lastProbeRun = new();
    private Dictionary<Guid, string> _probeAssignmentNames = new();
    private Dictionary<Guid, string> _checkerAssignmentNames = new();
    // snake_case assignment name -> friendly name; probe-result metadata keys are prefixed
    // with the snake_case name, so this recovers the instance behind each result row.
    private Dictionary<string, string> _probeAssignmentSnakeNames = new(StringComparer.Ordinal);

    private bool _probeResultsLoading;
    private ProbeResultResponse[] _probeResults = [];
    private int _pageSize = 25;
    private string[] _metricKeys = [];
    private string _metricSearch = string.Empty;

    private int _activeTab;
    private int ActiveTab
    {
        get => _activeTab;
        set
        {
            _activeTab = value;
            // Analysis tab (index 1) loads its range-scoped data lazily on first activation.
            if (value == 1 && !_analysisLoaded)
                _ = LoadAnalysisAsync();
        }
    }

    private StatusResponse[] _statusHistory = [];
    private DateTime? _analysisStart = DateTime.Now.AddHours(-24);
    private DateTime? _analysisEnd = DateTime.Now;
    // Stable ids shared between the analysis chart and the status strips so the strip
    // coordinator can read the chart's plot area for horizontal alignment.
    private readonly string _analysisFigureId = $"analysis-figure-{Guid.NewGuid():N}";
    private readonly string _analysisChartCanvasId = $"analysis-chart-{Guid.NewGuid():N}";

    // The pickers capture local wall-clock time; AnalysisRange() resolves it to UTC for the API.
    private static string LocalTzOffset()
    {
        var off = DateTimeOffset.Now.Offset;
        var sign = off < TimeSpan.Zero ? "-" : "+";
        return $"UTC{sign}{Math.Abs(off.Hours):00}:{Math.Abs(off.Minutes):00}";
    }

    private readonly HashSet<string> _selectedMetricKeys = new();
    private readonly Dictionary<string, MetricSeriesResponse?> _analysisSeries = new();
    private bool _analysisLoading;
    private bool _analysisLoaded;
    private HostDeclaredMetric[] _declaredMetrics = [];
    private readonly Dictionary<string, MetricSeriesResponse?> _metricSeries = new();
    private readonly HashSet<string> _metricSeriesLoading = new();
    private readonly Dictionary<string, IReadOnlyDictionary<double, string>?> _metricValueMaps = new();
    private readonly HashSet<ProbeResultResponse> _expandedResults = new();

    private Timer? _autoRefreshTimer;

    private bool _autoRefreshEnabled;
    private bool AutoRefreshEnabled
    {
        get => _autoRefreshEnabled;
        set
        {
            _autoRefreshEnabled = value;
            if (value)
                _autoRefreshTimer = new Timer(async _ => await InvokeAsync(async () =>
                {
                    await LoadProbeResultsAsync();
                    StateHasChanged();
                }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
            else
            {
                _autoRefreshTimer?.Dispose();
                _autoRefreshTimer = null;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _host = await Api.GetHostAsync(Id);
            if (_host is not null)
            {
                var effectiveTask = Api.GetEffectiveAssignmentsAsync(Id);
                var overridesTask = Api.GetOverridesAsync(Id);
                var statusHistoryTask = Api.GetStatusHistoryAsync(Id);
                var pluginsTask = Api.GetLoadedPluginsAsync();
                var groupsTask = Api.GetHostGroupsAsync();
                var latestProbeTask = Api.GetLatestProbeResultsPerProbeAsync(Id);
                var metricKeysTask = Api.GetMetricKeysAsync(Id);
                var directProbesTask = Api.GetProbeAssignmentsAsync(Id);
                var directCheckersTask = Api.GetCheckerAssignmentsAsync(Id);
                var declaredMetricsTask = Api.GetDeclaredMetricsAsync(Id);
                var nodesTask = Api.GetExecutorNodesAsync();

                try { await Task.WhenAll(effectiveTask, overridesTask, statusHistoryTask, pluginsTask, groupsTask, latestProbeTask, metricKeysTask, directProbesTask, directCheckersTask, declaredMetricsTask, nodesTask); }
                catch { /* Partial failures are surfaced per-task below via IsCompletedSuccessfully. */ }

                if (directProbesTask.IsCompletedSuccessfully)
                {
                    _probeAssignmentNames = directProbesTask.Result.ToDictionary(p => p.Id, p => p.Name);
                    _probeAssignmentSnakeNames = directProbesTask.Result
                        .GroupBy(p => p.NameSnakeCase, StringComparer.Ordinal)
                        .ToDictionary(g => g.Key, g => g.First().Name, StringComparer.Ordinal);
                }

                if (directCheckersTask.IsCompletedSuccessfully)
                    _checkerAssignmentNames = directCheckersTask.Result.ToDictionary(c => c.Id, c => c.Name);

                if (declaredMetricsTask.IsCompletedSuccessfully)
                {
                    _declaredMetrics = declaredMetricsTask.Result;
                    foreach (var m in _declaredMetrics)
                        _metricValueMaps[m.FullKey] = ParseValueMapping(m.ValueMappingJson);
                }

                if (effectiveTask.IsCompletedSuccessfully)
                {
                    var effective = effectiveTask.Result;
                    _effectiveProbes = effective?.Probes ?? [];
                    _effectiveCheckers = effective?.Checkers ?? [];
                }

                if (overridesTask.IsCompletedSuccessfully)
                {
                    var overrides = overridesTask.Result;
                    _probeOverrides = overrides?.Probes ?? [];
                    _checkerOverrides = overrides?.Checkers ?? [];
                }

                if (statusHistoryTask.IsCompletedSuccessfully)
                {
                    var statusHistory = statusHistoryTask.Result;
                    _checkerStatusLookup = statusHistory
                        .GroupBy(s => s.CheckerId)
                        .ToDictionary(g => g.Key, g => g.OrderByDescending(s => s.Timestamp).First().CurrentStatus);
                }

                if (pluginsTask.IsCompletedSuccessfully)
                    _loadedPlugins = pluginsTask.Result;

                if (nodesTask.IsCompletedSuccessfully)
                    _executorNodes = nodesTask.Result;

                if (groupsTask.IsCompletedSuccessfully)
                    _groupNames = groupsTask.Result.ToDictionary(g => g.Id, g => g.Name);

                if (latestProbeTask.IsCompletedSuccessfully)
                    _lastProbeRun = latestProbeTask.Result.ToDictionary(r => r.ProbeId, r => r.Timestamp);

                if (declaredMetricsTask.IsCompletedSuccessfully && _declaredMetrics.Length > 0)
                {
                    _metricKeys = _declaredMetrics.Select(m => m.FullKey).ToArray();
                    _ = LoadAllMetricSeriesAsync();
                }
                else if (metricKeysTask.IsCompletedSuccessfully)
                {
                    _metricKeys = metricKeysTask.Result;
                    _ = LoadAllMetricSeriesAsync();
                }
            }
        }
        catch (ApiException ax)
        {
            _error = ax.Message;
        }
        catch (Exception)
        {
            _error = "Unable to load host details. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private string ResolveGroupName(Guid? groupId) =>
        groupId.HasValue && _groupNames.TryGetValue(groupId.Value, out var name) ? name : "Unknown Group";

    private string? ResolveProbeAssignmentName(Guid assignmentId) =>
        _probeAssignmentNames.TryGetValue(assignmentId, out var n) ? n : null;

    private string? ResolveCheckerAssignmentName(Guid assignmentId) =>
        _checkerAssignmentNames.TryGetValue(assignmentId, out var n) ? n : null;

    private HostDeclaredMetric? ResolveDeclaration(string fullKey) =>
        _declaredMetrics.FirstOrDefault(m => m.FullKey == fullKey);

    private string[] FilterMetricKeys()
    {
        if (string.IsNullOrWhiteSpace(_metricSearch))
            return _metricKeys;

        // Fuzzy match: every whitespace-separated token must appear (case-insensitive)
        // somewhere in the metric's searchable text — probe name, display name/description,
        // unit, and plugin name (both raw id and the friendly form). This lets queries like
        // "ping ms" narrow across fields at once instead of matching a single substring.
        var tokens = _metricSearch.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        if (tokens.Length == 0) return _metricKeys;

        return _metricKeys
            .Where(key =>
            {
                var decl = ResolveDeclaration(key);
                var haystack = string.Join(' ',
                    key,
                    decl?.DisplayName,
                    decl?.Unit,
                    decl?.ProbeAssignmentName,
                    decl?.ProbePluginId,
                    decl is null ? null : ProbeNameFromPluginId(decl.ProbePluginId));
                return tokens.All(t => haystack.Contains(t, StringComparison.OrdinalIgnoreCase));
            })
            .ToArray();
    }

    private static IReadOnlyDictionary<double, string>? ParseValueMapping(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
                return null;
            var dict = new Dictionary<double, string>();
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (double.TryParse(prop.Name, System.Globalization.NumberStyles.Float,
                                    System.Globalization.CultureInfo.InvariantCulture, out var k)
                    && prop.Value.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    dict[k] = prop.Value.GetString() ?? string.Empty;
                }
            }
            return dict.Count == 0 ? null : dict;
        }
        catch { return null; }
    }

    private static string FormatLatest(double value, string? unit, IReadOnlyDictionary<double, string>? mapping)
    {
        if (mapping is not null && mapping.TryGetValue(value, out var label))
            return $"{label} ({value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)})";
        var numeric = value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        return unit is null ? numeric : $"{numeric} {unit}";
    }

    private static string FormatStat(double? value, string? unit, IReadOnlyDictionary<double, string>? mapping)
    {
        if (value is null) return "—";
        if (mapping is not null && mapping.TryGetValue(value.Value, out var label))
            return label;
        var numeric = value.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        return unit is null ? numeric : $"{numeric} {unit}";
    }

    private MonitoringStatus GetCheckerStatus(string checkerPluginId) =>
        _checkerStatusLookup.GetValueOrDefault(checkerPluginId, MonitoringStatus.Unknown);

    private async Task LoadEffectiveAssignmentsAsync()
    {
        var effectiveTask = Api.GetEffectiveAssignmentsAsync(Id);
        var overridesTask = Api.GetOverridesAsync(Id);
        var directCheckersTask = Api.GetCheckerAssignmentsAsync(Id);
        await Task.WhenAll(effectiveTask, overridesTask, directCheckersTask);

        var effective = effectiveTask.Result;
        _effectiveProbes = effective?.Probes ?? [];
        _effectiveCheckers = effective?.Checkers ?? [];

        var overrides = overridesTask.Result;
        _probeOverrides = overrides?.Probes ?? [];
        _checkerOverrides = overrides?.Checkers ?? [];

        if (directCheckersTask.IsCompletedSuccessfully)
            _checkerAssignmentNames = directCheckersTask.Result.ToDictionary(c => c.Id, c => c.Name);
    }

    private async Task OpenProbeOverrideDialog(EffectiveProbeAssignment probe)
    {
        var existingOverride = _probeOverrides.FirstOrDefault(o => o.AssignmentId == probe.AssignmentId);
        var parameters = new DialogParameters<OverrideEditDialog>
        {
            { x => x.PluginId, probe.ProbePluginId },
            { x => x.Plugins, _loadedPlugins },
            { x => x.CurrentConfigJson, probe.ConfigJson },
            { x => x.OverrideConfigJson, existingOverride?.ConfigJsonOverride },
            { x => x.IsDisabled, existingOverride?.IsDisabled ?? false },
            { x => x.IsNew, existingOverride is null }
        };

        var dialog = await DialogService.ShowAsync<OverrideEditDialog>("Probe Override", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: OverrideEditDialog.OverrideEditResult edit })
        {
            try
            {
                if (edit.Removed)
                {
                    await Api.DeleteProbeOverrideAsync(Id, probe.AssignmentId);
                    Snackbar.Add("Override removed.", Severity.Success);
