@page "/plugins"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Plugins - Mone</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Plugins</MudText>

<MudTabs Elevation="0" Rounded="true" PanelClass="pa-0 pt-4">
    <MudTabPanel Text="Catalog" Icon="@Icons.Material.Filled.Extension">
        <StateView Loading="_catalogLoading" Error="@_catalogError" IsEmpty="false">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @FilteredCatalog.Count of @_catalog.Length plugin@(_catalog.Length == 1 ? "" : "s")
                </MudText>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_showPrereleases" Color="Color.Primary" Label="Show prereleases" Class="mr-3" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync" Disabled="_busy">Reload</MudButton>
            </div>

            <div class="d-flex flex-column mb-4" style="gap:8px;">
                <div class="d-flex align-center" style="gap:8px; flex-wrap:wrap;">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width:60px;">State</MudText>
                    <MudChipSet T="StateFilter" SelectedValue="_stateFilter" SelectedValueChanged="OnStateFilterChanged"
                                CheckMark="true" Variant="Variant.Text" SelectionMode="SelectionMode.SingleSelection">
                        <MudChip T="StateFilter" Value="StateFilter.All">All</MudChip>
                        <MudChip T="StateFilter" Value="StateFilter.Installed">Installed</MudChip>
                        <MudChip T="StateFilter" Value="StateFilter.Available">Available</MudChip>
                        <MudChip T="StateFilter" Value="StateFilter.UpdateAvailable">Update available</MudChip>
                    </MudChipSet>
                </div>
                <div class="d-flex align-center" style="gap:8px; flex-wrap:wrap;">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width:60px;">Type</MudText>
                    <MudChipSet T="TypeFilter" SelectedValue="_typeFilter" SelectedValueChanged="OnTypeFilterChanged"
                                CheckMark="true" Variant="Variant.Text" SelectionMode="SelectionMode.SingleSelection">
                        <MudChip T="TypeFilter" Value="TypeFilter.All">All</MudChip>
                        <MudChip T="TypeFilter" Value="TypeFilter.Probe">Probe</MudChip>
                        <MudChip T="TypeFilter" Value="TypeFilter.Checker">Checker</MudChip>
                        <MudChip T="TypeFilter" Value="TypeFilter.Notification">Notifications</MudChip>
                    </MudChipSet>
                </div>
            </div>

            @if (_catalog.Length == 0)
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.ExtensionOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">No plugins found. Add a repository and sync to discover plugins.</MudText>
                </MudPaper>
            }
            else if (FilteredCatalog.Count == 0)
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Large" Class="mud-text-secondary mb-2" />
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">No plugins match the current filters.</MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var p in FilteredCatalog)
                    {
                        var visibleVersions = VisibleVersionsFor(p);
                        var selectedId = SelectedVersionIdFor(p, visibleVersions);
                        var selected = visibleVersions.FirstOrDefault(v => v.Id == selectedId);
                        var action = ResolveAction(p, selected);

                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudCard Elevation="2" Class="d-flex flex-column" Style="height:100%;">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <div class="d-flex align-center" style="gap:8px;">
                                            <MudText Typo="Typo.h6">@p.Name</MudText>
                                            @{
                                                var badge = StatusBadge(p.Status);
                                            }
                                            <MudChip T="string" Size="Size.Small" Color="@badge.color" Variant="Variant.Filled">@badge.label</MudChip>
                                        </div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.PluginType</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent Class="flex-grow-1">
                                    <MudText Typo="Typo.body2" Class="mb-2">@(p.Description ?? "No description")</MudText>
                                    <div class="d-flex flex-column mb-2" style="gap:2px;">
                                        @if (!string.IsNullOrEmpty(p.InstalledVersion))
                                        {
                                            <MudText Typo="Typo.caption">Installed: <strong>@p.InstalledVersion</strong></MudText>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Author))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">by @p.Author</MudText>
                                        }
                                    </div>
                                    @if (visibleVersions.Count > 0)
                                    {
                                        <MudSelect T="Guid" Value="selectedId" ValueChanged="@(id => OnVersionSelected(p.Name, id))"
                                                   Label="Version" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                            @foreach (var v in visibleVersions)
                                            {
                                                <MudSelectItem T="Guid" Value="v.Id">
                                                    @v.Version @(v.IsPrerelease ? " (prerelease)" : "")
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else if (p.Versions.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Only prerelease versions available — enable "Show prereleases" to select one.
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions Style="gap:8px;">
                                    @if (p.Status == PluginStatus.Installed && p.Versions.Count == 0)
                                    {
                                        @* Installed but no remote catalog (orphaned install) — uninstall only *@
                                        <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="@(() => UninstallAsync(p))" Disabled="_busy">
                                            Uninstall
                                        </MudButton>
                                    }
                                    else
                                    {
                                        @if (action.Kind == ActionKind.Install || action.Kind == ActionKind.Update || action.Kind == ActionKind.Reinstall)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="@action.Color"
                                                       StartIcon="@action.Icon"
                                                       OnClick="@(() => InstallSelectedAsync(p, selected!))"
                                                       Disabled="_busy || selected is null">
                                                @action.Label
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@action.Tooltip" Placement="Placement.Top">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true"
                                                           StartIcon="@action.Icon">
                                                    @action.Label
                                                </MudButton>
                                            </MudTooltip>
                                        }
                                        @if (!string.IsNullOrEmpty(p.InstalledVersion))
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="@(() => UninstallAsync(p))" Disabled="_busy">
                                                Uninstall
                                            </MudButton>
                                        }
                                    }
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </StateView>
    </MudTabPanel>

    <MudTabPanel Text="Repositories" Icon="@Icons.Material.Filled.Source">
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Add a repository</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="10">
                    <MudTextField @bind-Value="_newUrl" Label="Repository URL" Required="true"
                                  Placeholder="https://github.com/owner/repo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="AddRepoAsync"
                               Disabled="_busy || string.IsNullOrWhiteSpace(_newUrl)">
                        Add
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <StateView Loading="_reposLoading" Error="@_reposError" IsEmpty="@(_repos.Length == 0)"
                   EmptyText="No repositories configured."
                   EmptyIcon="@Icons.Material.Filled.Source">
            <MudDataGrid Items="_repos" Hover="true" Dense="true" T="PluginRepositoryResponse">
                <Columns>
                    <PropertyColumn Property="x => x.DisplayName" Title="Name" />
                    <TemplateColumn Title="URL">
                        <CellTemplate>
                            <MudLink Href="@($"https://github.com/{context.Item.Owner}/{context.Item.Repo}")"
                                     Target="_blank" Typo="Typo.body2">
                                @($"github.com/{context.Item.Owner}/{context.Item.Repo}")
                            </MudLink>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Last synced">
                        <CellTemplate>
                            @if (context.Item.LastSyncedAt is { } at)
                            {
                                <MudText Typo="Typo.caption">@at.ToLocalTime().ToString("g")</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">never</MudText>
                            }
                            @if (!string.IsNullOrEmpty(context.Item.LastSyncError))
                            {
                                <MudTooltip Text="@context.Item.LastSyncError">
                                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" Class="ml-1" />
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Actions">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small"
                                           OnClick="@(() => SyncRepoAsync(context.Item))" Disabled="_busy" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteRepoAsync(context.Item))" Disabled="_busy" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </StateView>
    </MudTabPanel>
</MudTabs>

@code {
    private bool _catalogLoading = true;
    private bool _reposLoading = true;
    private string? _catalogError;
    private string? _reposError;
    private bool _busy;
    private bool _showPrereleases;
    private PluginCatalogResponse[] _catalog = [];
    private PluginRepositoryResponse[] _repos = [];
    private readonly Dictionary<string, Guid> _selectedVersionByName = new(StringComparer.OrdinalIgnoreCase);

    private string _newUrl = "";

    private enum StateFilter { All, Installed, Available, UpdateAvailable }
    private enum TypeFilter { All, Probe, Checker, Notification }
    private enum ActionKind { Install, Update, Reinstall, UpToDate, BlockedDowngrade, BlockedNoStable }

    private sealed record TileAction(ActionKind Kind, string Label, string Icon, Color Color, string? Tooltip = null);

    private StateFilter _stateFilter = StateFilter.All;
    private TypeFilter _typeFilter = TypeFilter.All;

    private void OnStateFilterChanged(StateFilter v) => _stateFilter = v;
    private void OnTypeFilterChanged(TypeFilter v) => _typeFilter = v;

    private List<PluginCatalogResponse> FilteredCatalog => _catalog.Where(p =>
        (_stateFilter switch
        {
            StateFilter.Installed => p.Status == PluginStatus.Installed,
            StateFilter.Available => p.Status == PluginStatus.Available,
            StateFilter.UpdateAvailable => p.Status == PluginStatus.UpdateAvailable,
            _ => true,
        }) &&
        (_typeFilter switch
        {
            TypeFilter.Probe => string.Equals(p.PluginType, "Probe", StringComparison.OrdinalIgnoreCase),
            TypeFilter.Checker => string.Equals(p.PluginType, "Checker", StringComparison.OrdinalIgnoreCase),
            TypeFilter.Notification => string.Equals(p.PluginType, "AlertChannel", StringComparison.OrdinalIgnoreCase)
                                       || string.Equals(p.PluginType, "Notification", StringComparison.OrdinalIgnoreCase),
            _ => true,
        })).ToList();

    private IReadOnlyList<PluginVersionResponse> VisibleVersionsFor(PluginCatalogResponse p) =>
        _showPrereleases
            ? p.Versions
            : p.Versions.Where(v => !v.IsPrerelease).ToList();

    private Guid SelectedVersionIdFor(PluginCatalogResponse p, IReadOnlyList<PluginVersionResponse> visible)
    {
        if (_selectedVersionByName.TryGetValue(p.Name, out var explicitId) &&
            visible.Any(v => v.Id == explicitId))
            return explicitId;

        // Default: prefer the version matching the latest stable; fall back to the
        // first visible (which is already sorted descending).
        var preferred = visible.FirstOrDefault(v => v.Version == p.LatestStableVersion)
                        ?? visible.FirstOrDefault();
        return preferred?.Id ?? Guid.Empty;
    }

    private void OnVersionSelected(string pluginName, Guid versionId) =>
        _selectedVersionByName[pluginName] = versionId;

    private TileAction ResolveAction(PluginCatalogResponse p, PluginVersionResponse? selected)
    {
        if (selected is null)
        {
            return new TileAction(
                ActionKind.BlockedNoStable, "No version", Icons.Material.Filled.Block, Color.Default,
                "No installable version is selected. Enable 'Show prereleases' if applicable.");
        }

        var installed = p.InstalledVersion;
        if (string.IsNullOrEmpty(installed))
        {
            return new TileAction(ActionKind.Install, $"Install {selected.Version}",
                Icons.Material.Filled.Download, Color.Primary);
        }

        var cmp = SemverCompare(installed, selected.Version);
        if (cmp == 0)
        {
            return new TileAction(ActionKind.UpToDate, "Installed",
                Icons.Material.Filled.CheckCircle, Color.Success,
                "This version is already installed.");
        }

        if (cmp < 0)
        {
            return new TileAction(ActionKind.Update, $"Update to {selected.Version}",
                Icons.Material.Filled.SystemUpdate, Color.Secondary);
        }

        return new TileAction(ActionKind.BlockedDowngrade,
            $"Older than {installed}", Icons.Material.Filled.Block, Color.Default,
            "Downgrades are not supported. Uninstall first, then install the older version.");
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCatalogAsync(), LoadReposAsync());
    }

    private async Task LoadCatalogAsync()
    {
        _catalogLoading = true;
        _catalogError = null;
        try
        {
            _catalog = await Api.GetPluginCatalogAsync();

            // Drop stale per-tile selections (plugin disappeared from catalog).
            var live = _catalog.Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var key in _selectedVersionByName.Keys.Where(k => !live.Contains(k)).ToList())
                _selectedVersionByName.Remove(key);
        }
        catch (ApiException ax) { _catalogError = ax.Message; }
        catch (Exception) { _catalogError = "Unable to load the plugin catalog. Please try again."; }
        finally { _catalogLoading = false; }
    }

    private async Task LoadReposAsync()
    {
        _reposLoading = true;
        _reposError = null;
        try { _repos = await Api.GetPluginRepositoriesAsync(); }
        catch (ApiException ax) { _reposError = ax.Message; }
        catch (Exception) { _reposError = "Unable to load plugin repositories. Please try again."; }
        finally { _reposLoading = false; }
    }

    private async Task AddRepoAsync()
    {
        if (!TryParseRepoUrl(_newUrl, out var owner, out var repo, out var branch))
        {
            Snackbar.Add("Enter a valid GitHub URL (e.g. https://github.com/owner/repo)", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Api.AddPluginRepositoryAsync(new AddRepositoryRequest(owner, repo, branch, null));
            _newUrl = "";
            Snackbar.Add("Repository added — syncing in background", Severity.Success);
            await LoadReposAsync();
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private static bool TryParseRepoUrl(string? url, out string owner, out string repo, out string? branch)
    {
        owner = ""; repo = ""; branch = null;
        if (string.IsNullOrWhiteSpace(url)) return false;

        var s = url.Trim();

        // git@github.com:owner/repo(.git)
        if (s.StartsWith("git@", StringComparison.OrdinalIgnoreCase))
        {
            var colon = s.IndexOf(':');
            if (colon < 0) return false;
            s = s[(colon + 1)..];
        }
        else if (s.Contains("://"))
        {
            // strip scheme + host: https://github.com/owner/repo/...
            if (!Uri.TryCreate(s, UriKind.Absolute, out var uri)) return false;
            s = uri.AbsolutePath.TrimStart('/');
        }

        var parts = s.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2) return false;

        owner = parts[0];
        repo = StripGit(parts[1]);

        // .../tree/<branch>
        if (parts.Length >= 4 && string.Equals(parts[2], "tree", StringComparison.OrdinalIgnoreCase))
            branch = parts[3];

        return owner.Length > 0 && repo.Length > 0;
    }

    private static string StripGit(string s) =>
        s.EndsWith(".git", StringComparison.OrdinalIgnoreCase) ? s[..^4] : s;

    private async Task SyncRepoAsync(PluginRepositoryResponse repo)
    {
        _busy = true;
        try
        {
            await Api.SyncPluginRepositoryAsync(repo.Id);
            Snackbar.Add($"Synced {repo.DisplayName}", Severity.Success);
            await Task.WhenAll(LoadReposAsync(), LoadCatalogAsync());
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DeleteRepoAsync(PluginRepositoryResponse repo)
    {
        _busy = true;
        try
        {
            await Api.DeletePluginRepositoryAsync(repo.Id);
            Snackbar.Add($"Removed {repo.DisplayName}", Severity.Success);
            await Task.WhenAll(LoadReposAsync(), LoadCatalogAsync());
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task InstallSelectedAsync(PluginCatalogResponse p, PluginVersionResponse version)
    {
        _busy = true;
        try
        {
            await Api.InstallPluginAsync(version.Id);
            Snackbar.Add($"Installed {p.Name} {version.Version}", Severity.Success);
            await LoadCatalogAsync();
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task UninstallAsync(PluginCatalogResponse p)
    {
        _busy = true;
        try
        {
            await Api.UninstallPluginAsync(p.Name);
            Snackbar.Add($"Uninstalled {p.Name}", Severity.Success);
            await LoadCatalogAsync();
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            await Api.SyncAllPluginRepositoriesAsync();
            await Api.ReloadPluginsAsync();
            Snackbar.Add("Repositories synced and plugin engine reloaded", Severity.Success);
            await Task.WhenAll(LoadReposAsync(), LoadCatalogAsync());
        }
        catch (ApiException ax) { Snackbar.Add(ax.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private static (string label, Color color) StatusBadge(PluginStatus s) => s switch
    {
        PluginStatus.Installed => ("Installed", Color.Success),
        PluginStatus.UpdateAvailable => ("Update available", Color.Warning),
        PluginStatus.Available => ("Available", Color.Default),
        _ => ("Unknown", Color.Default)
    };

    private static int SemverCompare(string a, string b)
    {
        if (string.Equals(a, b, StringComparison.OrdinalIgnoreCase)) return 0;

        var (coreA, preA) = SplitVersion(a);
        var (coreB, preB) = SplitVersion(b);

        var coreCmp = CompareCore(coreA, coreB);
        if (coreCmp != 0) return coreCmp;

        if (string.IsNullOrEmpty(preA) && string.IsNullOrEmpty(preB)) return 0;
        if (string.IsNullOrEmpty(preA)) return 1;
        if (string.IsNullOrEmpty(preB)) return -1;
        return string.Compare(preA, preB, StringComparison.OrdinalIgnoreCase);
    }

    private static (string core, string prerelease) SplitVersion(string v)
    {
        var plus = v.IndexOf('+');
        if (plus >= 0) v = v[..plus];
        var dash = v.IndexOf('-');
        return dash < 0 ? (v, string.Empty) : (v[..dash], v[(dash + 1)..]);
    }

    private static int CompareCore(string a, string b)
    {
        var pa = a.Split('.');
        var pb = b.Split('.');
        var n = Math.Max(pa.Length, pb.Length);
        for (var i = 0; i < n; i++)
        {
            var xa = i < pa.Length && int.TryParse(pa[i], out var ia) ? ia : 0;
            var xb = i < pb.Length && int.TryParse(pb[i], out var ib) ? ib : 0;
            if (xa != xb) return xa.CompareTo(xb);
        }
        return 0;
    }
}
