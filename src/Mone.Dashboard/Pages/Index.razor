@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Mone Dashboard</PageTitle>

@if (_loading)
{
    <LoadingIndicator />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_summary is not null)
{
    <div class="obs-head">
        <div>
            <h1 class="obs-title">Dashboard</h1>
            <div class="obs-sub">Fleet telemetry · <span class="obs-mono">@_summary.TotalHosts hosts</span> monitored</div>
        </div>
        <div class="obs-uptime">
            <div class="obs-cap">Healthy share</div>
            <div class="obs-uptime-val">@HealthyShare</div>
        </div>
    </div>

    <div class="obs-grid">
        <div class="obs-tile obs-tile--total">
            <div class="obs-tile__num">@_summary.TotalHosts</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@Icons.Material.Filled.Dns" />
                Total Hosts
            </div>
        </div>
        <div class="obs-tile obs-tile--healthy">
            <div class="obs-tile__num">@_summary.Healthy</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@StatusColorHelper.ToIcon(MonitoringStatus.Healthy)" />
                @StatusColorHelper.ToLabel(MonitoringStatus.Healthy)
            </div>
        </div>
        <div class="obs-tile obs-tile--degraded">
            <div class="obs-tile__num">@_summary.Degraded</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@StatusColorHelper.ToIcon(MonitoringStatus.Degraded)" />
                @StatusColorHelper.ToLabel(MonitoringStatus.Degraded)
            </div>
        </div>
        <div class="obs-tile obs-tile--unhealthy">
            <div class="obs-tile__num">@_summary.Unhealthy</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@StatusColorHelper.ToIcon(MonitoringStatus.Unhealthy)" />
                @StatusColorHelper.ToLabel(MonitoringStatus.Unhealthy)
            </div>
        </div>
        <div class="obs-tile obs-tile--unreachable">
            <div class="obs-tile__num">@_summary.Unreachable</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@StatusColorHelper.ToIcon(MonitoringStatus.Unreachable)" />
                @StatusColorHelper.ToLabel(MonitoringStatus.Unreachable)
            </div>
        </div>
        <div class="obs-tile obs-tile--unknown">
            <div class="obs-tile__num">@_summary.Unknown</div>
            <div class="obs-tile__label">
                <MudIcon Icon="@StatusColorHelper.ToIcon(MonitoringStatus.Unknown)" />
                @StatusColorHelper.ToLabel(MonitoringStatus.Unknown)
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private DashboardSummaryResponse? _summary;

    private string HealthyShare => _summary is { TotalHosts: > 0 } s
        ? $"{(double)s.Healthy / s.TotalHosts * 100:0.#}%"
        : "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Api.GetDashboardSummaryAsync();
        }
        catch (ApiException ax)
        {
            _error = ax.Message;
        }
        catch (Exception)
        {
            _error = "Unable to load the dashboard summary. Please try again.";
        }
        _loading = false;
    }
}
