@page "/credentials"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Credentials - Mone</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Credentials</MudText>

<StateView Loading="_loading" Error="@_error" IsEmpty="@(_credentials.Length == 0)"
           EmptyText="No credentials yet"
           EmptyIcon="@Icons.Material.Filled.VpnKey"
           EmptyActionText="Add Credentials"
           EmptyActionIcon="@Icons.Material.Filled.Add"
           OnEmptyAction="OpenCreateDialog">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog" Class="mb-4">Add Credentials</MudButton>

    <MudDataGrid Items="_credentials" Hover="true" Dense="true" T="CredentialsResponse">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Username" Title="Username" />
            <TemplateColumn Title="Password">
                <CellTemplate>
                    <MudText>@ObfuscatePassword(context.Item.Password ?? "")</MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="g" />
            <PropertyColumn Property="x => x.UpdatedAt" Title="Updated" Format="g" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => ConfirmDelete(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</StateView>

@code {
    private bool _loading = true;
    private string? _error;
    private CredentialsResponse[] _credentials = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCredentialsAsync();
    }

    private async Task LoadCredentialsAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _credentials = await Api.GetCredentialsAsync();
        }
        catch (ApiException ax)
        {
            _error = ax.Message;
        }
        catch (Exception)
        {
            _error = "Unable to load credentials. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CredentialsDialog>();
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CredentialsDialog>("Add Credentials", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadCredentialsAsync();
        }
    }

    private async Task OpenEditDialog(CredentialsResponse creds)
    {
        var parameters = new DialogParameters<CredentialsDialog>
        {
            { x => x.Credentials, creds }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CredentialsDialog>("Edit Credentials", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadCredentialsAsync();
        }
    }

    private async Task ConfirmDelete(CredentialsResponse creds)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Delete credentials '{creds.Name}'? This action cannot be undone.",
            "Delete",
            "Cancel");

        if (confirm ?? false)
        {
            try
            {
                await Api.DeleteCredentialsAsync(creds.Id);
                Snackbar.Add("Credentials deleted successfully", Severity.Success);
                await LoadCredentialsAsync();
            }
            catch (ApiException ex)
            {
                Snackbar.Add($"Failed to delete: {ex.Message}", Severity.Error);
            }
        }
    }

    private string ObfuscatePassword(string password)
    {
        if (string.IsNullOrEmpty(password))
            return "—";

        var length = password.Length;
        if (length <= 4)
            return new string('*', length);

        var quarterLength = length / 4;
        var firstPart = password[..quarterLength];
        var lastPart = password[(length - quarterLength)..];
        var middleLength = length - (2 * quarterLength);
        var middlePart = new string('*', middleLength);

        return $"{firstPart}{middlePart}{lastPart}";
    }
}
