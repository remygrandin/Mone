@using Mone.Dashboard.Models
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Name" Required="true" RequiredError="Name is required"
                         Disabled="@IsEditMode" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_username" Label="Username" Required="true" RequiredError="Username is required"
                         Variant="Variant.Outlined" Class="mt-4" />
            <MudTextField @bind-Value="_password" Label="@(_showPassword ? "Password" : "Password (hidden)")"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                         Required="@(!IsEditMode)" RequiredError="Password is required"
                         Variant="Variant.Outlined" Class="mt-4"
                         Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         OnAdornmentClick="@ToggleShowPassword" />
            @if (IsEditMode)
            {
                <MudText Typo="Typo.caption" Class="mt-2">
                    Leave password blank to keep existing password
                </MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            @(IsEditMode ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public CredentialsResponse? Credentials { get; set; }

    private MudForm _form = null!;
    private string _name = string.Empty;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _showPassword = false;

    private bool IsEditMode => Credentials is not null;

    protected override void OnInitialized()
    {
        if (IsEditMode)
        {
            _name = Credentials!.Name;
            _username = Credentials.Username;
        }
    }

    private void ToggleShowPassword() => _showPassword = !_showPassword;

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        try
        {
            if (IsEditMode)
            {
                var request = new UpdateCredentialsRequest(_name, _username, string.IsNullOrEmpty(_password) ? null : _password);
                await Api.UpdateCredentialsAsync(Credentials!.Id, request);
                Snackbar.Add("Credentials updated successfully", Severity.Success);
            }
            else
            {
                var request = new CreateCredentialsRequest(_name, _username, _password);
                await Api.CreateCredentialsAsync(request);
                Snackbar.Add("Credentials created successfully", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
