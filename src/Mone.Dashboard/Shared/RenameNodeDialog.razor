<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name" Label="Display name" Variant="Variant.Outlined"
                      Required="true" RequiredError="Display name is required"
                      HelperText="Renames only the display name shown in the registry." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(Name)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Name { get; set; } = "";

    private void Submit() => MudDialog.Close(DialogResult.Ok(Name));

    private void Cancel() => MudDialog.Cancel();
}
