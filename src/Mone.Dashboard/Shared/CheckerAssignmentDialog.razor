@using Mone.Dashboard.Models
@using System.Text.Json
@using MudBlazor

<MudDialog>
    <TitleContent>@(IsEdit ? "Edit Checker Assignment" : "Add Checker Assignment")</TitleContent>
    <DialogContent>
        <MudSelect T="LoadedPluginModel" Label="Checker Plugin" Required="true"
                   Value="_selectedPlugin" ValueChanged="OnPluginSelected"
                   ToStringFunc="@(p => p?.Name ?? string.Empty)"
                   Disabled="@IsEdit">
            @foreach (var plugin in Plugins.Where(p => string.Equals(p.Kind, "Checker", StringComparison.OrdinalIgnoreCase)))
            {
                <MudSelectItem Value="@plugin">@plugin.Name (@plugin.PluginId)</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="Model.Name" Label="Name" Required="true"
                      HelperText="@($"Snake-case key: {ComputeSnake(Model.Name)}")" Class="mt-3" />

        @if (_selectedPlugin?.ConfigManifest?.Fields is { Count: > 0 } fields && fields.Any(f => !f.IsGlobal))
        {
            <div class="mt-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Configuration</MudText>
                <ManifestFormFields Fields="@fields" Values="@_configValues" ValuesChanged="@(v => _configValues = v)" MetricKeySuggestions="@MetricKeys" />
            </div>
        }

        <MudSelect T="Guid?" Label="Run on node" Value="Model.ExecutorNodeId" ValueChanged="@(v => Model.ExecutorNodeId = v)"
                   Clearable="true" Class="mt-3"
                   HelperText="Leave empty to run on every checker engine. Bind to pin this checker to a single node.">
            <MudSelectItem T="Guid?" Value="@((Guid?)null)">Any node</MudSelectItem>
            @foreach (var node in CheckerNodes())
            {
                <MudSelectItem T="Guid?" Value="@node.Id">@node.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch @bind-Value="Model.Enabled" Label="Enabled" Color="Color.Primary" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_selectedPlugin is null || string.IsNullOrWhiteSpace(Model.Name))">
            @(IsEdit ? "Save" : "Add")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<LoadedPluginModel> Plugins { get; set; } = [];
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string[] MetricKeys { get; set; } = [];
    [Parameter] public IReadOnlyList<ExecutorNodeResponse> Nodes { get; set; } = [];

    private IEnumerable<ExecutorNodeResponse> CheckerNodes() =>
        Nodes.Where(n => n.Roles.Contains("Checker", StringComparer.OrdinalIgnoreCase));

    private LoadedPluginModel? _selectedPlugin;
    private Dictionary<string, string> _configValues = new();

    protected override void OnParametersSet()
    {
        if (IsEdit && !string.IsNullOrEmpty(Model.CheckerPluginId))
        {
            _selectedPlugin = Plugins.FirstOrDefault(p => p.PluginId == Model.CheckerPluginId);
            if (!string.IsNullOrEmpty(Model.ConfigJson))
            {
                try { _configValues = JsonSerializer.Deserialize<Dictionary<string, string>>(Model.ConfigJson) ?? new(); }
                catch { _configValues = new(); }
            }
        }
    }

    private void OnPluginSelected(LoadedPluginModel? plugin)
    {
        _selectedPlugin = plugin;
        _configValues = new Dictionary<string, string>();
        if (plugin is not null)
        {
            Model.CheckerPluginId = plugin.PluginId;
            if (string.IsNullOrWhiteSpace(Model.Name))
                Model.Name = plugin.Name;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (_configValues.Count > 0)
        {
            var nonEmpty = _configValues.Where(kv => !string.IsNullOrEmpty(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value);
            Model.ConfigJson = nonEmpty.Count > 0 ? JsonSerializer.Serialize(nonEmpty) : null;
        }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private static string ComputeSnake(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "(name required)";
        var sb = new System.Text.StringBuilder(raw.Length);
        var lastUnderscore = true;
        for (var i = 0; i < raw.Length; i++)
        {
            var c = raw[i];
            if (i > 0 && IsBoundary(raw, i))
            {
                if (!lastUnderscore) { sb.Append('_'); lastUnderscore = true; }
            }
            if (char.IsLetterOrDigit(c))
            {
                sb.Append(char.ToLowerInvariant(c));
                lastUnderscore = false;
            }
            else if (!lastUnderscore && sb.Length > 0)
            {
                sb.Append('_');
                lastUnderscore = true;
            }
        }
        while (sb.Length > 0 && sb[^1] == '_') sb.Length--;
        return sb.Length == 0 ? "(invalid)" : sb.ToString();
    }

    private static bool IsBoundary(string s, int i)
    {
        if (i == 0) return false;
        var p = s[i - 1]; var c = s[i];
        if (char.IsUpper(c) && char.IsLower(p)) return true;
        if (char.IsDigit(c) && char.IsLetter(p)) return true;
        if (char.IsLetter(c) && char.IsDigit(p)) return true;
        return false;
    }

    public sealed class FormModel
    {
        public string CheckerPluginId { get; set; } = "";
        public string Name { get; set; } = "";
        public string? ConfigJson { get; set; }
        public bool Enabled { get; set; } = true;
        public Guid? ExecutorNodeId { get; set; }
    }
}
