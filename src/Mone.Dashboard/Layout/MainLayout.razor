@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Mone.Dashboard.Auth
@using Mone.Dashboard.Services
@using Mone.Dashboard.Models
@using Mone.Dashboard.Theme
@inject AuthService AuthService
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject PermissionState Permissions
@inject ThemeService ThemeService
@inject ApiClient ApiClient

<MudThemeProvider @ref="_themeProvider" Theme="MoneTheme.Instance" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@ToggleDrawer" />
                <MudText Typo="Typo.h5" Class="ml-3">Mone Dashboard</MudText>
                <MudSpacer />
                <MudMenu Icon="@_themeMenuIcon" Color="Color.Inherit" AriaLabel="Theme mode">
                    <MudMenuItem Icon="@Icons.Material.Filled.LightMode" OnClick="@(() => SetThemeMode(ThemeMode.Light))">Light</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" OnClick="@(() => SetThemeMode(ThemeMode.Dark))">Dark</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.BrightnessAuto" OnClick="@(() => SetThemeMode(ThemeMode.System))">System</MudMenuItem>
                </MudMenu>
                <MudButton Color="Color.Inherit" OnClick="HandleLogout">Logout</MudButton>
            </MudAppBar>
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <MudNavMenu>
                    @* Overview *@
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

                    @* Monitoring *@
                    @if (Permissions.Has(PermissionResource.Hosts) || Permissions.Has(PermissionResource.Groups) || Permissions.Has(PermissionResource.Notifications))
                    {
                        <MudDivider Class="my-2" />
                    }
                    @if (Permissions.Has(PermissionResource.Hosts))
                    {
                        <MudNavLink Href="/hosts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dns">Hosts</MudNavLink>
                    }
                    @if (Permissions.Has(PermissionResource.Groups))
                    {
                        <MudNavLink Href="/groups" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">Groups</MudNavLink>
                    }
                    @if (Permissions.Has(PermissionResource.Notifications))
                    {
                        <MudNavLink Href="/notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
                    }

                    @* Infrastructure *@
                    @if (Permissions.Has(PermissionResource.ExecutorNodes) || Permissions.Has(PermissionResource.Plugins))
                    {
                        <MudDivider Class="my-2" />
                    }
                    @if (Permissions.Has(PermissionResource.ExecutorNodes))
                    {
                        <MudNavLink Href="/nodes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub">Executor Nodes</MudNavLink>
                    }
                    @if (Permissions.Has(PermissionResource.Plugins))
                    {
                        <MudNavLink Href="/plugins" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Extension">Plugins</MudNavLink>
                        <MudNavLink Href="/credentials" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey">Credentials</MudNavLink>
                    }

                    @* Maintenance *@
                    @if (Permissions.Has(PermissionResource.System))
                    {
                        <MudDivider Class="my-2" />
                        <MudNavLink Href="/housekeeping" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CleaningServices">Housekeeping</MudNavLink>
                    }

                    @* Administration *@
                    @if (Permissions.Has(PermissionResource.Administration))
                    {
                        <MudDivider Class="my-2" />
                        <MudNavLink Href="/admin/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Roles</MudNavLink>
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
                    }
                </MudNavMenu>
            </MudDrawer>
            <MudMainContent Class="pa-4 pt-20">
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <MudLayout>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private MudThemeProvider _themeProvider = null!;

    private string _themeMenuIcon => ThemeService.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadPermissionsAsync(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.SetSystemPreference(await _themeProvider.GetSystemPreference());
            await _themeProvider.WatchSystemPreference(prefersDark =>
            {
                ThemeService.SetSystemPreference(prefersDark);
                return Task.CompletedTask;
            });
            StateHasChanged();
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadPermissionsAsync(await task);
            StateHasChanged();
        });
    }

    private async Task LoadPermissionsAsync(AuthenticationState authState)
    {
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            try
            {
                await Permissions.EnsureLoadedAsync(force: true);
                var me = await ApiClient.GetMeAsync();
                if (me is not null)
                {
                    var mode = Enum.TryParse<ThemeMode>(me.ThemePreference, out var parsed)
                        ? parsed
                        : ThemeMode.System;
                    ThemeService.SetMode(mode);
                }
            }
            catch
            {
                // Navigation simply hides gated links if capabilities can't be loaded;
                // a failed theme load is non-fatal and leaves the default System mode.
            }
        }
        else
        {
            Permissions.Reset();
        }
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void SetThemeMode(ThemeMode mode)
    {
        ThemeService.SetMode(mode);
        // Fire-and-forget persistence; an API failure must never block the UI.
        _ = ApiClient.UpdateThemeAsync(mode.ToString());
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Permissions.Reset();
        AuthStateProvider.NotifyAuthStateChanged();
        Navigation.NavigateTo("/login");
    }
}
